# ═══════════════════════════════════════════════════════════════
#  ห้ามขึ้น GitHub เด็ดขาด — มีความลับ / ข้อมูลส่วนบุคคล
# ═══════════════════════════════════════════════════════════════

# รหัสผ่านฐานข้อมูล
.env

# ไฟล์ dump ฐานข้อมูล — มีรหัสผ่าน (hash) ของพนักงาน, ข้อมูลลูกค้า,
# เลขประจำตัวผู้เสียภาษี และ agent_token ของเครื่องพิมพ์
pos_db.sql
pos_db_update.sql
*.sql

# token ที่ใช้จับคู่กับโปรแกรมพิมพ์
local-agent/config.json

# รูป QR รับเงินของร้าน + ไฟล์ที่ผู้ใช้อัปโหลด
/public/uploads/*
!/public/uploads/.gitkeep

# ═══════════════════════════════════════════════════════════════
#  ของที่เกิดตอนใช้งาน / สร้างขึ้นมาเอง
# ═══════════════════════════════════════════════════════════════

/writable/*
!/writable/index.html
# เก็บโครงโฟลเดอร์ไว้ ไม่งั้น clone ใหม่แล้ว CI4 เขียนไฟล์ไม่ได้
!/writable/*/
/writable/*/*
!.gitkeep

/dist/
/backup/
# releases/ = ก้อนอัพเดทที่ส่งให้เครื่องร้านโหลด -> ต้องขึ้น repo
*.bak-*
*.log

# โปรแกรมพิมพ์ (Electron) — ใหญ่มาก อัพเดทแยกต่างหาก
/local-agent/node_modules/
/local-agent/dist/

# เบ็ดเตล็ด
Thumbs.db
.DS_Store
/.claude/
